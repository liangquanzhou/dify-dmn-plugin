{
  "schema_version": "service-decision-dsl.node-architecture.v2",
  "example_only": true,
  "deployment": {
    "runtime_owner": "HOST",
    "action_backend": "HOST",
    "business_enabled": false,
    "enabled_node_kinds": [
      "START",
      "DECISION",
      "END",
      "QUERY",
      "ACTION",
      "EXCLUSIVE"
    ]
  },
  "workflows": [
    {
      "workflow_id": "support",
      "version": "1",
      "flow_type": "SOLVE",
      "scope": "EXAMPLE_FRAGMENT",
      "entry_phase": "P1",
      "domain_id": "synthetic",
      "scene_ref": null,
      "phases": [
        {
          "phase_id": "P1",
          "entry_step": "eligibility",
          "steps": [
            {
              "step_id": "eligibility",
              "name": "Eligibility",
              "purpose": "Synthetic gate",
              "profile": "decision-step-v2",
              "version": "1",
              "entry_node": "begin",
              "main_decision_node": "decide",
              "max_attempts": 1,
              "graph": {
                "nodes": [
                  {
                    "node_id": "begin",
                    "name": "Begin",
                    "category": "EVENT",
                    "kind": "START",
                    "ports": [
                      "ok"
                    ]
                  },
                  {
                    "node_id": "decide",
                    "name": "Eligibility",
                    "category": "EXECUTION",
                    "kind": "DECISION",
                    "ports": [
                      "ok",
                      "error",
                      "blocked"
                    ],
                    "model_ref": "eligibility",
                    "input_bindings": {
                      "eligible": {
                        "from": {
                          "source": "context",
                          "path": [
                            "eligible"
                          ]
                        },
                        "source_format": "PARAMETER"
                      }
                    }
                  },
                  {
                    "node_id": "done",
                    "name": "Done",
                    "category": "EVENT",
                    "kind": "END",
                    "ports": [],
                    "exit_ref": "business"
                  },
                  {
                    "node_id": "stop",
                    "name": "Stopped",
                    "category": "EVENT",
                    "kind": "END",
                    "ports": [],
                    "exit_ref": "technical"
                  }
                ],
                "edges": [
                  {
                    "edge_id": "e0",
                    "source": "begin",
                    "source_port": "ok",
                    "target": "decide"
                  },
                  {
                    "edge_id": "e1",
                    "source": "decide",
                    "source_port": "ok",
                    "target": "done"
                  },
                  {
                    "edge_id": "e2",
                    "source": "decide",
                    "source_port": "error",
                    "target": "stop"
                  },
                  {
                    "edge_id": "e3",
                    "source": "decide",
                    "source_port": "blocked",
                    "target": "stop"
                  }
                ]
              },
              "exits": {
                "business": {
                  "class": "BUSINESS",
                  "destination": {
                    "kind": "END_WORKFLOW",
                    "outcome": "business"
                  }
                },
                "technical": {
                  "class": "TECHNICAL",
                  "destination": {
                    "kind": "END_WORKFLOW",
                    "outcome": "technical"
                  }
                }
              },
              "reentry_exhausted_exit": "technical"
            }
          ]
        }
      ]
    }
  ],
  "models": {
    "eligibility": {
      "profile": "service-decision-table-v1",
      "version": "fixture-1",
      "hit_policy": "UNIQUE",
      "parameters": {
        "eligible": {
          "type": "boolean",
          "record_required": true,
          "nullable": false,
          "allowed_quality": [
            "KNOWN",
            "UNKNOWN",
            "CONFLICT",
            "NOT_APPLICABLE"
          ]
        }
      },
      "rules": [
        {
          "rule_id": "yes",
          "when": [
            {
              "path": [
                "parameters",
                "eligible",
                "value"
              ],
              "op": "eq",
              "value": true
            }
          ],
          "output_template_ref": "accepted"
        }
      ],
      "result_templates": {
        "accepted": {
          "state": "ELIGIBLE",
          "data": {
            "eligibility": {
              "from": {
                "source": "parameters",
                "path": [
                  "eligible",
                  "value"
                ]
              }
            }
          },
          "actions": []
        },
        "empty": {
          "state": "INELIGIBLE",
          "data": {},
          "actions": []
        }
      },
      "on_no_match": "RESULT_TEMPLATE",
      "empty_template_ref": "empty"
    }
  },
  "capabilities": {},
  "asset_locks": {}
}
